# Environment Configuration for Calorie Tracker API

# Server Configuration
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://calorie-tracker.piogino.ch

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=calorie_tracker_user
DB_PASSWORD=
DB_NAME=calorie_tracker

# JWT Configuration (REQUIRED - Generate a secure random string)
# You can generate one using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Open Food Facts
OPEN_FOOD_FACTS_USER_AGENT=
OPEN_FOOD_FACTS_TIMEOUT=

# Cache
CACHE_CLEANUP_ENABLED=

# Web Push / VAPID (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=